# Copie para .env e ajuste. Nunca versione o arquivo .env.
PORT=8080
DATABASE_URL=postgres://finance:finance@localhost:5432/finance?sslmode=disable
# Gere com: openssl rand -hex 32  (mínimo 32 caracteres)
JWT_SECRET=troque-este-valor-por-um-segredo-com-no-minimo-32-caracteres

# Testes de integração: servidor PostgreSQL com permissão para criar bancos.
# Cada teste cria e remove um banco próprio. Sem esta variável, esses testes são ignorados.
TEST_DATABASE_URL=postgres://finance:finance@localhost:5432/postgres?sslmode=disable
